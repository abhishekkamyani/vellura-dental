# PostgreSQL connection string. The default matches docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://vellura:vellura@localhost:5433/vellura_dental?schema=public"

# Google Gemini API key — create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional: use Groq automatically if Gemini is unavailable (create a key at https://console.groq.com/keys).
# GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"

# Optional: Gemini model used by the concierge (defaults to gemini-2.5-flash).
# GEMINI_MODEL="gemini-2.5-flash"

# Optional: IANA timezone the clinic operates in (defaults to Asia/Karachi, never the server's timezone).
# CLINIC_TIMEZONE="Asia/Karachi"

# Optional: Unsplash API access key. When set, imagery is fetched live by keyword;
# otherwise curated Unsplash photos are used.
# UNSPLASH_ACCESS_KEY=""

# Optional: Gemini model to try when the primary Gemini model is overloaded.
# GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"

# Auth.js session signing secret. Generate one with: openssl rand -base64 33
AUTH_SECRET=""
# Trust the Host header (required when self-hosting outside Vercel).
AUTH_TRUST_HOST=true

# Optional: credentials used by `npm run db:seed-admin` (defaults shown).
# ADMIN_EMAIL="admin@velluradental.com"
# ADMIN_PASSWORD="password123"
