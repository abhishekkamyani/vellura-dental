generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Service {
  id           String        @id @default(cuid())
  name         String        @unique
  durationMin  Int
  imageQuery   String
  appointments Appointment[]
}

model Appointment {
  id          String            @id @default(cuid())
  patientName String
  phone       String
  serviceId   String
  service     Service           @relation(fields: [serviceId], references: [id])
  startTime   DateTime
  endTime     DateTime
  status      AppointmentStatus @default(CONFIRMED)
  createdAt   DateTime          @default(now())

  @@index([startTime, endTime])
}

// --- Auth.js (NextAuth v5) models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// bcrypt hash, never the plain-text password.
  password      String?
  role          String    @default("ADMIN")
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
